{
    "playwright": {
        "command": "npx",
        "args": [
            "@playwright/mcp@latest"
        ]
    },
    "demo-shop-magento2": {
        "command": "node",
        "args": [
            "magento2-admin-mcp-server-v2/dist/server.js"
        ],
        "env": {
            "MCP_TITLE": "Demo Shop",
            "MAGENTO_BASE_URL": "https://your-magento-shop.com",
            "MAGENTO_INTEGRATION_TOKEN": "YourIntegrationTokenHere",
            "FEATURED_APIS_0": "lvl2_app__list_modules::get::/V1/neutromelabs_mcp/modules",
            "FEATURED_APIS_0_DESCRIPTION": "List all enabled modules",
            "FEATURED_APIS_1": "lvl2_app__list_module_files::get::/V1/neutromelabs_mcp/modules/{moduleName}/files",
            "FEATURED_APIS_1_DESCRIPTION": "List all files in a module",
            "FEATURED_APIS_2": "lvl2_app__get_module_file_content::get::/V1/neutromelabs_mcp/modules/{moduleName}/content",
            "FEATURED_APIS_2_DESCRIPTION": "Get the content of a file in a module",
            "FEATURED_APIS_3": "lvl2_app__execute_arbitrary_php::post::/V1/neutromelabs_mcp/execute/php",
            "FEATURED_APIS_3_DESCRIPTION": "Execute arbitrary PHP code",
            "FEATURED_APIS_4": "lvl3_env__execute_arbitrary_sql::post::/V1/neutromelabs_mcp/execute/sql",
            "FEATURED_APIS_4_DESCRIPTION": "Execute arbitrary SQL code",
            "FEATURED_APIS_5": "lvl3_env__execute_arbitrary_shell::post::/V1/neutromelabs_mcp/execute/shell",
            "FEATURED_APIS_5_DESCRIPTION": "Execute arbitrary shell commands"
        },
        "timeout": 300
    }
}