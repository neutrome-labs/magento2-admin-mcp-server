MCP_TITLE=Demo Shop

MAGENTO_BASE_URL=https://your-magento-shop.com
MAGENTO_INTEGRATION_TOKEN=YourIntegrationTokenHere

MAGENTO_PHP_EXECUTABLE=/usr/bin/php
MAGENTO_PHP_VERSION=8.1
MAGENTO_VERSION=2.4.6
MAGENTO_EDITION=CE
MAGENTO_MODE=developer
MAGENTO_FS_ROOT=/var/www/html

# FEATURED_APIS_K=lvl[x]_[scope]__[name]::[http-method]::[http-path]
# FEATURED_APIS_K_DESCRIPTION=Description of the API

# NutromeLabs_Mcp
FEATURED_APIS_100=lvl2_app__list_modules::get::/V1/neutromelabs_mcp/modules
FEATURED_APIS_100_DESCRIPTION=List all enabled modules
FEATURED_APIS_101=lvl2_app__list_module_files::get::/V1/neutromelabs_mcp/modules/{moduleName}/files
FEATURED_APIS_101_DESCRIPTION=List all files in a module
FEATURED_APIS_102=lvl2_app__get_module_file_content::get::/V1/neutromelabs_mcp/modules/{moduleName}/content
FEATURED_APIS_102_DESCRIPTION=Get the content of a file in a module
FEATURED_APIS_103=lvl2_app__execute_arbitrary_php::post::/V1/neutromelabs_mcp/execute/php
FEATURED_APIS_103_DESCRIPTION=Execute arbitrary PHP code
FEATURED_APIS_104=lvl3_env__execute_arbitrary_sql::post::/V1/neutromelabs_mcp/execute/sql
FEATURED_APIS_104_DESCRIPTION=Execute arbitrary SQL code
FEATURED_APIS_105=lvl3_env__execute_arbitrary_shell::post::/V1/neutromelabs_mcp/execute/shell
FEATURED_APIS_105_DESCRIPTION=Execute arbitrary shell commands
FEATURED_APIS_106=lvl2_app__list_logs::get::/V1/neutromelabs_mcp/logs
FEATURED_APIS_106_DESCRIPTION=List all log files from application
FEATURED_APIS_107=lvl2_app__get_log_file_content::get::/V1/neutromelabs_mcp/logs/tail
FEATURED_APIS_107_DESCRIPTION=Get the content of a log file from application (?filePath=system.log&lines=30)

