# Magefan_Blog
FEATURED_APIS_9010=lvl1_rest__get_blog_post_list::get::/V1/blog/post/list/{type}/{term}/{store_id}/{page}/{limit}
FEATURED_APIS_9010_DESCRIPTION=Get a list of blog posts via Magefan_Blog (keep type and term empty, store_id=0)
FEATURED_APIS_906=lvl1_rest__create_blog_post::post::/V1/blog/post
FEATURED_APIS_906_DESCRIPTION=Create a blog post via Magefan_Blog
FEATURED_APIS_907=lvl1_rest__update_blog_post::put::/V1/blog/post/{id}
FEATURED_APIS_907_DESCRIPTION=Update a blog post via Magefan_Blog
FEATURED_APIS_908=lvl1_rest__delete_blog_post::delete::/V1/blog/post/{id}
FEATURED_APIS_908_DESCRIPTION=Delete a blog post via Magefan_Blog
FEATURED_APIS_909=lvl1_rest__get_blog_post::get::/V1/blog/post/{id}
FEATURED_APIS_909_DESCRIPTION=Get a blog post via Magefan_Blog
FEATURED_APIS_910=lvl1_rest__view_blog_post::get::/V1/blog/post/view/{id}/{store_id}
FEATURED_APIS_910_DESCRIPTION=View a blog post for a specific store via Magefan_Blog
FEATURED_APIS_911=lvl1_rest__create_blog_category::post::/V1/blog/category
FEATURED_APIS_911_DESCRIPTION=Create a blog category via Magefan_Blog
FEATURED_APIS_912=lvl1_rest__update_blog_category::put::/V1/blog/category/{id}
FEATURED_APIS_912_DESCRIPTION=Update a blog category via Magefan_Blog
FEATURED_APIS_913=lvl1_rest__delete_blog_category::delete::/V1/blog/category/{id}
FEATURED_APIS_913_DESCRIPTION=Delete a blog category via Magefan_Blog
FEATURED_APIS_914=lvl1_rest__get_blog_category::get::/V1/blog/category/{id}
FEATURED_APIS_914_DESCRIPTION=Get a blog category via Magefan_Blog
FEATURED_APIS_915=lvl1_rest__view_blog_category::get::/V1/blog/category/view/{id}/{store_id}
FEATURED_APIS_915_DESCRIPTION=View a blog category for a specific store via Magefan_Blog
FEATURED_APIS_916=lvl1_rest__get_blog_category_list::get::/V1/blog/category/list/{type}/{term}/{store_id}/{page}/{limit}
FEATURED_APIS_916_DESCRIPTION=Get a list of blog categories via Magefan_Blog