# Magefan_Blog
FEATURED_APIS_6=lvl1_rest__create_blog_post::post::/V1/blog/post
FEATURED_APIS_6_DESCRIPTION=Create a blog post
FEATURED_APIS_7=lvl1_rest__update_blog_post::put::/V1/blog/post/{id}
FEATURED_APIS_7_DESCRIPTION=Update a blog post
FEATURED_APIS_8=lvl1_rest__delete_blog_post::delete::/V1/blog/post/{id}
FEATURED_APIS_8_DESCRIPTION=Delete a blog post
FEATURED_APIS_9=lvl1_rest__get_blog_post::get::/V1/blog/post/{id}
FEATURED_APIS_9_DESCRIPTION=Get a blog post
FEATURED_APIS_10=lvl1_rest__get_blog_post_list::get::/V1/blog/post/list/{type}/{term}/{store_id}/{page}/{limit}
FEATURED_APIS_10_DESCRIPTION=Get a list of blog posts