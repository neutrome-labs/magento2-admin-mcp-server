{
    "demo-shop-magento2": {
      "command": "node",
      "args": [
        "magento2-admin-mcp-server-v2/dist/server.js"
      ],
      "env": {
        "MCP_TITLE": "Demo Shop",
        "MAGENTO_BASE_URL": "https://your-magento-shop.com",
        "MAGENTO_INTEGRATION_TOKEN": "YourIntegrationTokenHere"
      },
      "disabled": false,
      "autoApprove": [
        "lvl1_rest__search_api_methods",
        "lvl1_rest__get_api_definitions"
      ],
      "timeout": 300
    }
}