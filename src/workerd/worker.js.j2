/**
 * workerd worker module — Jinja2-rendered per execution.
 *
 * Bindings injected by runner.py:
 *   env.MAGENTO_URL   — Magento base URL
 *   env.MAGENTO_TOKEN — Magento admin token
 *
 * Template variables from Jinja2:
 *   {{ openapi_schema_json }} — full OpenAPI schema as JSON string
 *   {{ expression }}          — user's TypeScript expression
 */

const OPENAPI_SCHEMA = JSON.parse(`{{ openapi_schema_json }}`);

/**
 * Pre-authenticated Magento REST helper.
 *
 * @param {string} method  HTTP method (GET, POST, PUT, DELETE, PATCH)
 * @param {string} path    REST path, e.g. "/V1/orders/123"
 * @param {object} [body]  Optional JSON body
 * @returns {Promise<any>} Parsed JSON response
 */
async function fetchMagento(method, path, body) {
  const url = `${MAGENTO_URL}/rest${path.startsWith('/') ? '' : '/'}${path}`;
  const opts = {
    method: method.toUpperCase(),
    headers: {
      'Authorization': `Bearer ${MAGENTO_TOKEN}`,
      'Content-Type': 'application/json',
      'Accept': 'application/json',
    },
  };
  if (body !== undefined && body !== null) {
    opts.body = JSON.stringify(body);
  }
  const resp = await fetch(url, opts);
  const text = await resp.text();
  if (!resp.ok) {
    throw new Error(`Magento ${method} ${path} → ${resp.status}: ${text.slice(0, 500)}`);
  }
  try {
    return JSON.parse(text);
  } catch {
    return text;
  }
}

// ── Execute the user's expression and output result ────────────────────

export default {
  async fetch(request, env) {
    // Expose bindings as globals for the expression
    globalThis.MAGENTO_URL = env.MAGENTO_URL;
    globalThis.MAGENTO_TOKEN = env.MAGENTO_TOKEN;
    globalThis.OPENAPI_SCHEMA = OPENAPI_SCHEMA;
    globalThis.fetchMagento = fetchMagento;

    try {
      const result = await (async () => {
        return {{ expression }};
      })();
      return new Response(JSON.stringify(result, null, 2), {
        headers: { 'Content-Type': 'application/json' },
      });
    } catch (err) {
      return new Response(JSON.stringify({
        error: err.message || String(err),
        stack: err.stack,
      }), {
        status: 500,
        headers: { 'Content-Type': 'application/json' },
      });
    }
  },
};
